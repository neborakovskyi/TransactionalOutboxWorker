{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "Simple",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
        "IncludeScopes": true,
        "UseUtcTimestamp": false
      }
    }
  },

  "AllowedHosts": "*",

  "ServiceBus": {
    "FullyQualifiedNamespace": "my-namespace.servicebus.windows.net",
    "EntityName": "outbox-events"
  }
}
