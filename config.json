            },
            "Subscriptions": [
              {
                "Name": "my-subscription",
                "Properties": {
                  "LockDuration": "PT1M"
                }
              }
            ]
          }
        ]
      }
    ],
    "Logging": {
      "Type": "Console"
    }
  }
}
